# ========== 行尾策略：仓库与工作区统一 LF，杜绝跨平台漂移 ==========
# 规则为"后者覆盖前者"，通配兜底必须放在最前

*               text=auto

# 源文件与工程配置：显式钉死 LF（不依赖内容嗅探，也不受本机 core.autocrlf 影响）
*.c             text eol=lf
*.h             text eol=lf
*.cpp           text eol=lf
*.hpp           text eol=lf
*.cc            text eol=lf
*.s             text eol=lf
*.S             text eol=lf
*.ld            text eol=lf
*.cfg           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
*.ioc           text eol=lf
*.mk            text eol=lf
*.mxproject     text eol=lf
LICENSE         text eol=lf
Makefile        text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.clang-format   text eol=lf
.editorconfig   text eol=lf

# ========== 二进制：禁止任何行尾/文本转换 ==========
*.pdf           binary
*.jpg           binary
*.jpeg          binary
*.png           binary
*.gif           binary
*.bmp           binary
*.ico           binary
*.fnt           binary
*.ttf           binary
*.woff          binary
*.elf           binary
*.hex           binary
*.bin           binary
*.o             binary
*.a             binary
*.zip           binary
*.gz            binary
